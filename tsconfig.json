{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "lib": [
      "ES2024",
      "DOM",
      "ESNext.Disposable"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "src"
  ]
}
